#!/usr/bin/env bash
# Steam client 1791918634 — one-paste bootstrap.
# Does not replace valveoff-1.5. That command stays:
#   curl -fsSL https://raw.githubusercontent.com/dvahana2424-web/hammerdeckydowngrade/valveoff-1.5/bootstrap | bash
#
# This build:
#   curl -fsSL https://raw.githubusercontent.com/dvahana2424-web/hammerdeckydowngrade/steam-1791918634/bootstrap | bash
#
set -uo pipefail
REPO="${VALVEOFF_REPO:-dvahana2424-web/hammerdeckydowngrade}"
BRANCH="${VALVEOFF_BRANCH:-steam-1791918634}"
export VALVEOFF_INSTALL_REV=1791918634
exec bash <(curl -fsSL "https://raw.githubusercontent.com/${REPO}/${BRANCH}/install?ts=$(date +%s)")
