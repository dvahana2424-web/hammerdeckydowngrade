#!/usr/bin/env bash
# Crimson Desert bin64 pack — one-paste bootstrap (SteamOS / Bazzite / Linux).
#
#   curl -fsSL https://raw.githubusercontent.com/dvahana2424-web/hammerdeckydowngrade/crimson-desert/bootstrap | bash
#
# GitHub raw CDN can cache `install` for several minutes; always use bootstrap.
set -uo pipefail
REPO="${CRIMSON_REPO:-dvahana2424-web/hammerdeckydowngrade}"
BRANCH="${CRIMSON_BRANCH:-crimson-desert}"
export CRIMSON_INSTALL_REV=1
exec bash <(curl -fsSL "https://raw.githubusercontent.com/${REPO}/${BRANCH}/install?ts=$(date +%s)")
