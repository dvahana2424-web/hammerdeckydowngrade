#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  ValveOFF 1.5 — ONE-PASTE installer for Steam Deck Stable 1794424036
#
#  Usage (Desktop Mode → Konsole, do NOT run as root):
#
#    curl -fsSL https://raw.githubusercontent.com/dvahana2424-web/hammerdeckydowngrade/steamrt64-1794424036/bootstrap | bash
#
#  Prefer `bootstrap` over `install` directly — GitHub raw CDN can serve a stale
#  `install` copy for several minutes after an update.
#
#  This branch STAYS on Steam 1794424036 (no downgrade, no steam.cfg lock).
#  It uses the steamrt64 client. ELF64 Hammer loads there. The empty file
#  .steam-disable-steamrt64-client forces ubuntu12_32, so this installer
#  deletes that sentinel. LD_AUDIT stays ON.
#
#  Older commands are unchanged (the 32-bit one still writes the sentinel):
#    curl -fsSL https://raw.githubusercontent.com/dvahana2424-web/hammerdeckydowngrade/steam-1794424036/bootstrap | bash
#    curl -fsSL https://raw.githubusercontent.com/dvahana2424-web/hammerdeckydowngrade/valveoff-1.5/bootstrap | bash
#    curl -fsSL https://raw.githubusercontent.com/dvahana2424-web/hammerdeckydowngrade/steam-1791918634/bootstrap | bash
#    curl -fsSL https://raw.githubusercontent.com/dvahana2424-web/hammerdeckydowngrade/steam-1792618285/bootstrap | bash
#
#  ValveOFF 1.4 (unchanged — do NOT use this branch for 1.4):
#    curl -fsSL https://raw.githubusercontent.com/dvahana2424-web/hammerdeckydowngrade/main/install | bash
#
#  What this does, fully automatic, ONE sudo password prompt:
#    1. Detects the host (SteamOS / Bazzite / generic Linux).
#    2. SMART CLEANUP of any previous OneTap / SLSsteam install
#       (also deletes steam.cfg so Steam auto-update stays on).
#    3. Deletes ~/.local/share/Steam/.steam-disable-steamrt64-client
#       (and the same file under ~/.steam/root and ~/.steam/steam)
#       so the 64-bit client is allowed to start.
#    4. Downloads the stripped ValveOFF 1.5 folder hosted on THIS branch
#       into ~/Downloads/ValveOFF 1.5/ (ELF64 libs, config, hammer-decky).
#    5. Installs Decky Loader (latest) if it isn't already present.
#    6. Installs Hammer + ValveOFF + hammer-decky and wires Desktop-Mode unlock.
#    7. Applies Game-Mode unlock (steam-jupiter on SteamOS, /usr/local/bin/steam
#       wrapper on Bazzite/atomic). LD_AUDIT stays ON.
#    8. Refreshes hammersteam.so, library-inject.so, and config.yaml from
#       this branch after extract. hammer-decky stays the copy inside the
#       bundle (keyboard fix). The old valveoff-1.5 bundle is not used.
#
#  Override the bundle source if you self-host:
#    VALVEOFF_BUNDLE_URL=https://example/valveoff-bundle.tar.gz curl ... | bash
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

# steamrt64-1794424036-install-rev=1794424036-steamrt64-v1
# Do not bounce to steam-1794424036 (that branch writes the 32-bit sentinel)
# or to Headcrab pins. This branch keeps LD_AUDIT on and does not downgrade Steam.
_INSTALL_PIN="${VALVEOFF_INSTALL_REF:-steamrt64-1794424036}"
if [ "${VALVEOFF_INSTALL_REV:-}" != "1794424036-steamrt64-v1" ]; then
	export VALVEOFF_INSTALL_REV=1794424036-steamrt64-v1
fi

# ── Config ──────────────────────────────────────────────────────────────────
# ValveOFF 1.5 branch — separate from main (ValveOFF 1.4). Do not point 1.4
# installs here; use `main` for 1.4.
REPO="dvahana2424-web/hammerdeckydowngrade"
BRANCH="steamrt64-1794424036"
TARGET_STEAM_BUILD=1794424036
EXPECTED_HAMMER_MD5="${EXPECTED_HAMMER_MD5:-3677322f2ef2597ef16673f3b1614c98}"
EXPECTED_INJECT_MD5="${EXPECTED_INJECT_MD5:-cae5920ce4b55a334646da078baa6fa4}"
# Unused on this branch (no Steam downgrade). Kept so SKIP helpers still parse.
STEAM_TRACKING_SHA="${STEAM_TRACKING_SHA:-}"
STEAM_DOWNGRADE_PARALLEL="${STEAM_DOWNGRADE_PARALLEL:-4}"
# Packed from the stripped workspace folder ValveOFF 1.5.
# valveoff-1.5 remains the older bundle. This installer does not use it.
BUNDLE_BRANCH="${VALVEOFF_BUNDLE_BRANCH:-steamrt64-1794424036}"
BUNDLE_FILE="valveoff-bundle.tar.gz"
BUNDLE_RAW_BASE="${VALVEOFF_BUNDLE_RAW_BASE:-https://raw.githubusercontent.com/$REPO/$BUNDLE_BRANCH}"
BRANCH_RAW_BASE="https://raw.githubusercontent.com/$REPO/$BRANCH"
# sha256 of the concatenated parts.
BUNDLE_SHA256="${VALVEOFF_BUNDLE_SHA256:-c63b734ebe8080b2af9e1601928ccdb3e50a0808f895d0a9872342171448e27c}"
HAMMER_DECKY_PKG="${HAMMER_DECKY_PKG:-hammer-decky-0.9.24.tar.gz}"
# Default tarball lives on hamdeck (small); override with HAMMER_DECKY_PKG_URL.
HAMMER_DECKY_PKG_URL="${HAMMER_DECKY_PKG_URL:-https://raw.githubusercontent.com/dvahana2424-web/hamdeck/hammer-1.1.17/hammer-decky/${HAMMER_DECKY_PKG}}"
# Space-separated list of part suffixes, concatenated in order.
BUNDLE_PARTS="${VALVEOFF_BUNDLE_PARTS:-00 01}"
# Optional single-file override (self-hosting): if set, skip the split parts.
BUNDLE_URL="${VALVEOFF_BUNDLE_URL:-}"
BUNDLE_DIRNAME="ValveOFF 1.5"   # folder name created inside Downloads/

# ── Colors (no-op when not a tty) ───────────────────────────────────────────
if [ -t 1 ]; then
	C_RST=$'\033[0m'; C_B=$'\033[1m'; C_G=$'\033[32m'; C_Y=$'\033[33m'
	C_R=$'\033[31m'; C_C=$'\033[36m'
else
	C_RST=""; C_B=""; C_G=""; C_Y=""; C_R=""; C_C=""
fi
ok()    { printf "%s[OK]%s   %s\n"  "$C_G" "$C_RST" "$*"; }
warn()  { printf "%s[WARN]%s %s\n"  "$C_Y" "$C_RST" "$*"; }
err()   { printf "%s[ERR]%s  %s\n"  "$C_R" "$C_RST" "$*" >&2; }
info()  { printf "%s[..]%s   %s\n"  "$C_C" "$C_RST" "$*"; }
title() { printf "\n%s━━ %s ━━%s\n" "$C_B" "$*" "$C_RST"; }
die()   { err "$*"; exit 1; }

# ── Pre-flight ──────────────────────────────────────────────────────────────
if [ "$(id -u)" = "0" ]; then
	die "Do NOT run this as root. Paste it in Konsole as your normal user (deck / bazzite / etc.). It will ask for sudo once."
fi
command -v curl >/dev/null 2>&1 || die "curl is required but not found."
command -v tar  >/dev/null 2>&1 || die "tar is required but not found."

HOME_DIR="$HOME"
USER_NAME="$(id -un)"

# Resolve the Downloads folder (respect localized XDG dirs; fall back to ~/Downloads).
resolve_downloads_dir() {
	local d=""
	if command -v xdg-user-dir >/dev/null 2>&1; then
		d="$(xdg-user-dir DOWNLOAD 2>/dev/null || true)"
	fi
	[ -z "$d" ] && d="$HOME_DIR/Downloads"
	mkdir -p "$d" 2>/dev/null || true
	echo "$d"
}
DL_DIR="$(resolve_downloads_dir)"
DEST="$DL_DIR/$BUNDLE_DIRNAME"

# ── Distro detection ────────────────────────────────────────────────────────
IS_STEAMOS=0; IS_BAZZITE=0; IS_ATOMIC=0
detect_distro() {
	local osr="/etc/os-release"; [ -r "$osr" ] || osr="/usr/lib/os-release"
	local idline=""
	[ -r "$osr" ] && idline="$(tr 'A-Z' 'a-z' < "$osr")"
	case "$idline" in *steamos*|*holo*) IS_STEAMOS=1 ;; esac
	case "$idline" in *bazzite*) IS_BAZZITE=1 ;; esac
	case "$idline" in *silverblue*|*kinoite*|*bazzite*) IS_ATOMIC=1 ;; esac
	# rpm-ostree + immutable /usr is also "atomic"
	if command -v rpm-ostree >/dev/null 2>&1 && [ "$(stat -c %m /usr 2>/dev/null)" = "/usr" ]; then
		IS_ATOMIC=1
	fi
	# steamos-readonly tool is the most reliable SteamOS signal
	command -v steamos-readonly >/dev/null 2>&1 && IS_STEAMOS=1

	local label="generic Linux"
	[ "$IS_ATOMIC" = 1 ]  && label="atomic/immutable (rpm-ostree)"
	[ "$IS_BAZZITE" = 1 ] && label="Bazzite"
	[ "$IS_STEAMOS" = 1 ] && label="SteamOS (Steam Deck)"
	info "Detected host: ${C_B}${label}${C_RST}"
}

# ── Single sudo prompt + keepalive ──────────────────────────────────────────
SUDO_KEEPALIVE_PID=""
prime_sudo() {
	title "Admin access (one password)"
	info "Asking for your sudo password ONCE. It is cached for the rest of the install."
	if ! sudo -v; then die "sudo authentication failed."; fi
	# Refresh the cached credential in the background so the big download
	# never lets the 5-minute sudo timeout lapse mid-install.
	( while true; do sudo -n true 2>/dev/null; sleep 50; kill -0 "$$" 2>/dev/null || exit 0; done ) &
	SUDO_KEEPALIVE_PID=$!
	ok "sudo ready (cached)."
}
cleanup() { [ -n "$SUDO_KEEPALIVE_PID" ] && kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true; }
trap cleanup EXIT INT TERM

# ── SteamOS read-only rootfs helpers (no-op off SteamOS) ────────────────────
RO_TOGGLED=0
usr_writable() {
	# Same logic as install.sh probe_usr_writable — non-root EACCES != ro rootfs.
	if [ "$(id -u)" = "0" ]; then
		local p="/usr/bin/.valveoff-rw-$$"
		if ( : > "$p" ) 2>/dev/null; then rm -f "$p" 2>/dev/null; return 0; fi
		return 1
	fi
	sudo test -w /usr/bin 2>/dev/null && return 0
	command -v steamos-readonly >/dev/null 2>&1 \
		&& steamos-readonly status 2>/dev/null | grep -qiE 'disabled|off' && return 0
	return 1
}
unlock_rootfs() {
	command -v steamos-readonly >/dev/null 2>&1 || return 0
	usr_writable && return 0
	info "Disabling SteamOS read-only filesystem (sudo)…"
	if sudo steamos-readonly disable 2>/dev/null; then
		if usr_writable; then
			RO_TOGGLED=1; ok "/usr is writable (via sudo / steamos-readonly disabled)."
		else
			warn "steamos-readonly disable ran but /usr still looks locked."
		fi
	else
		warn "Could not disable steamos-readonly — Game-Mode steps may fail."
	fi
}
relock_rootfs() {
	[ "$RO_TOGGLED" = 1 ] || return 0
	sudo steamos-readonly enable 2>/dev/null && ok "Re-enabled SteamOS read-only (safe default)." || \
		warn "Could not re-enable readonly — run: sudo steamos-readonly enable"
	RO_TOGGLED=0
}

# ── Stop Steam so file patches apply cleanly ────────────────────────────────
stop_steam() {
	if pgrep -x steam >/dev/null 2>&1 || pgrep -x steamwebhelper >/dev/null 2>&1; then
		info "Closing Steam so changes apply cleanly…"
		pkill -TERM steam steamwebhelper 2>/dev/null || true
		sleep 2
		pkill -KILL steam steamwebhelper 2>/dev/null || true
	fi
	# Also stop via steam -shutdown when available (cleaner tray exit).
	command -v steam >/dev/null 2>&1 && steam -shutdown 2>/dev/null || true
}

# Remove Hammer LD_AUDIT from Deck launchers so textmode downgrade + Steam start
# are not poisoned by steam-jupiter re-exporting 32-bit audit libs.
# Rename Hammer audit .so so even a poisoned steam-jupiter LD_AUDIT cannot load them.
disable_hammer_audit_libs() {
	local hammer_dir="$HOME_DIR/.local/share/Hammer" f
	mkdir -p "$hammer_dir"
	for f in hammersteam.so library-inject.so; do
		if [ -f "$hammer_dir/$f" ]; then
			mv -f "$hammer_dir/$f" "$hammer_dir/$f.disabled-downgrade"
			ok "Disabled $hammer_dir/$f (prevents ELFCLASS32 / SEGV during downgrade)"
		fi
	done
}

strip_hammer_ld_audit() {
	title "Strip Hammer LD_AUDIT (required for Steam downgrade)"
	local changed=0 f tmp

	# Always neutralize the .so files first (no sudo needed; works even if
	# steam-jupiter keep re-exporting LD_AUDIT).
	disable_hammer_audit_libs

	# Desktop Mode launchers (user-writable).
	for f in \
		"$HOME_DIR/.local/share/applications/steam.desktop" \
		"$HOME_DIR/.local/share/applications/steam-native.desktop"; do
		[ -f "$f" ] || continue
		if grep -q 'LD_AUDIT=.*Hammer\|hammersteam\.so\|library-inject\.so' "$f" 2>/dev/null; then
			sed -i 's|env LD_AUDIT="[^"]*" ||g' "$f"
			ok "Stripped LD_AUDIT from $f"
			changed=1
		fi
	done

	# Game Mode / Deck: /usr/bin/steam → steam-jupiter (needs writable /usr).
	for f in /usr/bin/steam-jupiter /usr/local/bin/steam; do
		[ -f "$f" ] || continue
		if ! grep -qE 'Hammer|hammersteam\.so|library-inject\.so|hammer-ld-audit' "$f" 2>/dev/null; then
			continue
		fi
		unlock_rootfs
		tmp="$(mktemp)"
		# Drop ValveOFF hammer-ld-audit block + any leftover Hammer LD_AUDIT lines.
		awk '
			/# >>> hammer-ld-audit >>>/ { skip=1; next }
			/# <<< hammer-ld-audit <<</ { skip=0; next }
			skip { next }
			/LD_AUDIT=.*Hammer|LD_AUDIT=.*hammersteam|LD_AUDIT=.*library-inject|export LD_AUDIT=.*Hammer/ { next }
			{ print }
		' "$f" > "$tmp"
		if sudo install -m 0755 "$tmp" "$f"; then
			ok "Stripped Hammer LD_AUDIT from $f"
			changed=1
		else
			warn "Could not edit $f — Hammer .so already disabled, downgrade can continue."
		fi
		rm -f "$tmp"
	done

	if [ "$changed" = 0 ]; then
		ok "Launcher LD_AUDIT clean (or Hammer .so already disabled)."
	fi
}

# ═════════════════════════════════════════════════════════════════════════════
#  STEAM BUILD DETECT + remove the 32-bit sentinel (no downgrade on this branch)
# ═════════════════════════════════════════════════════════════════════════════
resolve_steam_package_dir() {
	local d
	for d in \
		"$HOME_DIR/.steam/steam/package" \
		"$HOME_DIR/.local/share/Steam/package" \
		"$HOME_DIR/.var/app/com.valvesoftware.Steam/.steam/steam/package"; do
		if [ -d "$d" ]; then
			echo "$d"
			return 0
		fi
	done
	return 1
}

# Must match steam-cache/steam_channel.py MANIFEST_CANDIDATES (newest .installed/.manifest wins).
_STEAM_PKG_CHANNELS=(
	steam_client_steamdeck_stable_steamrt64
	steam_client_steamdeck_publicbeta_steamrt64
	steam_client_steamdeck_stable_ubuntu12
	steam_client_steamdeck_publicbeta_ubuntu12
	steam_client_ubuntu12
	steam_client_publicbeta_ubuntu12
)

pick_active_steam_channel() {
	local pkg="$1" name best="" best_mtime=0 mtime f
	for name in "${_STEAM_PKG_CHANNELS[@]}"; do
		for f in "$pkg/${name}.installed" "$pkg/${name}.manifest"; do
			if [ -f "$f" ]; then
				mtime="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
				if [ "$mtime" -gt "$best_mtime" ]; then
					best_mtime="$mtime"
					best="$name"
				fi
				break
			fi
		done
	done
	[ -n "$best" ] && echo "$best"
}

read_version_from_pkg_manifest() {
	local manifest="$1" ver
	[ -f "$manifest" ] || return 1
	ver="$(grep -m1 '"version"' "$manifest" \
		| sed -n 's/.*"version"[[:space:]]*"\([0-9][0-9]*\)".*/\1/p')"
	[ -n "$ver" ] || return 1
	echo "$ver"
}

read_installed_steam_build() {
	local pkg active manifest ver
	pkg="$(resolve_steam_package_dir)" || return 1
	active="$(pick_active_steam_channel "$pkg")" || return 1
	manifest="$pkg/${active}.manifest"
	read_version_from_pkg_manifest "$manifest"
}

steam_client_running() {
	local prog pid state
	for prog in steam steamwebhelper reaper; do
		while read -r pid; do
			[ -n "$pid" ] || continue
			state="$(awk '{print $3}' "/proc/$pid/stat" 2>/dev/null)" || continue
			[ "$state" = "Z" ] && continue
			return 0
		done < <(pgrep -x "$prog" 2>/dev/null || true)
	done
	return 1
}

# Steam writes this empty file to force ubuntu12_32. ELF64 Hammer cannot load
# there (ld.so: wrong ELF class). Detect every copy and delete it.
clear_steamrt64_sentinel() {
	title "Allow steamrt64 client (remove 32-bit sentinel)"
	local steam_dir removed=0 seen="" sentinel real
	info "Looking for .steam-disable-steamrt64-client (STEAM_FORCE_CLIENT=ubuntu12_32)."
	for steam_dir in \
		"$HOME_DIR/.local/share/Steam" \
		"$HOME_DIR/.steam/steam" \
		"$HOME_DIR/.steam/root" \
		"$HOME_DIR/.var/app/com.valvesoftware.Steam/.local/share/Steam" \
		"$HOME_DIR/.var/app/com.valvesoftware.Steam/.steam/steam"; do
		[ -d "$steam_dir" ] || continue
		real="$(readlink -f "$steam_dir" 2>/dev/null || echo "$steam_dir")"
		case " $seen " in
			*" $real "*) continue ;;
		esac
		seen="$seen $real"
		sentinel="$steam_dir/.steam-disable-steamrt64-client"
		if [ -e "$sentinel" ] || [ -L "$sentinel" ]; then
			rm -f -- "$sentinel"
			ok "Removed 32-bit client sentinel: $sentinel"
			removed=1
		fi
	done
	if [ "$removed" = 0 ]; then
		ok "No .steam-disable-steamrt64-client sentinel (steamrt64 stays enabled)"
	fi
	local steamrt="$HOME_DIR/.local/share/Steam/steamrt64/steam"
	if [ -x "$steamrt" ]; then
		ok "steamrt64 client is on disk: $steamrt"
	else
		warn "steamrt64 is not downloaded yet."
		warn "  Launch Steam once, let the update finish, then launch it again."
		warn "  ELF64 Hammer loads only inside that 64-bit client."
	fi
}

# 1794424036 path: stay on the installed Steam Deck Stable client.
# Do not Headcrab-downgrade. Do not write steam.cfg (auto-update stays on).
ensure_steam_target_build() {
	title "Steam client → stay on Deck Stable $TARGET_STEAM_BUILD (no downgrade)"
	local current="" pkg active
	pkg="$(resolve_steam_package_dir 2>/dev/null || true)"
	active=""
	if [ -n "$pkg" ]; then
		active="$(pick_active_steam_channel "$pkg" 2>/dev/null || true)"
	fi
	current="$(read_installed_steam_build 2>/dev/null || true)"
	if [ -n "$active" ]; then
		info "Active Steam channel: $active"
	fi
	if [ -n "$current" ]; then
		info "Detected Steam client build: $current"
		if [ "$current" = "$TARGET_STEAM_BUILD" ]; then
			ok "Steam is already build $TARGET_STEAM_BUILD."
		else
			warn "Installed build is $current, not $TARGET_STEAM_BUILD."
			warn "This installer does not downgrade. Update Steam to Deck Stable 1794424036, or use steam-1792618285 / steam-1791918634."
		fi
	else
		warn "Could not read installed Steam build from package/*.manifest"
		warn "Continuing — ELF64 Hammer overlay will still be applied, and the 32-bit sentinel will be removed."
	fi
	if [ -n "$active" ] && [[ "$active" != *"_steamrt64" ]]; then
		warn "Active channel is $active, not steamrt64."
		warn "Removing .steam-disable-steamrt64-client so the next start can use steamrt64."
	fi
	clear_steamrt64_sentinel
	return 0
}

# ═════════════════════════════════════════════════════════════════════════════
#  SMART CLEANUP — previous OneTap / SLSsteam installation
# ═════════════════════════════════════════════════════════════════════════════
SLS_DIR="$HOME_DIR/.local/share/SLSsteam"
SLS_CFG_DIR="$HOME_DIR/.config/SLSsteam"
APPS_DIR="$HOME_DIR/.local/share/applications"

onetap_present() {
	[ -d "$SLS_DIR" ] && return 0
	[ -d "$SLS_CFG_DIR" ] && return 0
	[ -f "$APPS_DIR/steam-onetap.desktop" ] && return 0
	# any patched steam binary referencing SLSsteam
	for b in /usr/bin/steam-jupiter /usr/bin/steam /usr/local/bin/steam; do
		[ -f "$b" ] && grep -q "SLSsteam" "$b" 2>/dev/null && return 0
	done
	# any steam.cfg that inhibits updates
	for c in \
		"$HOME_DIR/.steam/steam/steam.cfg" \
		"$HOME_DIR/.steam/root/steam.cfg" \
		"$HOME_DIR/.local/share/Steam/steam.cfg"; do
		[ -f "$c" ] && grep -qi "BootStrapper" "$c" 2>/dev/null && return 0
	done
	return 1
}

# Remove OneTap's Desktop-Mode unlock (.desktop entries + LD_AUDIT wrappers).
onetap_remove_desktop_unlock() {
	rm -f "$APPS_DIR/steam-onetap.desktop" 2>/dev/null && ok "Removed steam-onetap.desktop"
	# OneTap PATH wrappers live under SLSsteam/path/
	if [ -d "$SLS_DIR/path" ]; then
		rm -rf "$SLS_DIR/path" 2>/dev/null && ok "Removed SLSsteam PATH wrappers"
	fi
	# .desktop overrides patched by OneTap (reference SLSsteam). Our installer
	# will recreate clean Hammer versions afterwards.
	for d in steam.desktop steam-native.desktop; do
		if [ -f "$APPS_DIR/$d" ] && grep -q "SLSsteam" "$APPS_DIR/$d" 2>/dev/null; then
			rm -f "$APPS_DIR/$d" && ok "Removed OneTap-patched $d"
		fi
	done
	# OneTap shell PATH snippet (fish)
	rm -f "$HOME_DIR/.config/fish/conf.d/SLSsteam.fish" 2>/dev/null || true
}

# Strip OneTap's LD_AUDIT (SLSsteam) lines from a steam launcher binary.
_strip_sls_ld_audit() {
	local bin="$1"
	[ -f "$bin" ] || return 0
	grep -q "SLSsteam" "$bin" 2>/dev/null || return 0
	local tmp; tmp="$(mktemp)"
	# Drop any line that sets LD_AUDIT to an SLSsteam path (with or without export).
	grep -vE '^[[:space:]]*(export[[:space:]]+)?LD_AUDIT=.*SLSsteam' "$bin" > "$tmp" 2>/dev/null
	if sudo install -m 0755 "$tmp" "$bin" 2>/dev/null; then
		ok "Stripped OneTap LD_AUDIT from $bin"
	else
		warn "Could not edit $bin (permission) — skipping."
	fi
	rm -f "$tmp"
}

# Remove OneTap's Game-Mode unlock (steam-jupiter / steam).
onetap_remove_gamemode_unlock() {
	unlock_rootfs
	# Prefer restoring OneTap's own backup if it exists.
	local bak="$SLS_DIR/steam-jupiter.bak"
	if [ -f "$bak" ]; then
		local tgt; tgt="$(command -v steam-jupiter 2>/dev/null || echo /usr/bin/steam-jupiter)"
		if [ -f "$tgt" ] && sudo install -m 0755 "$bak" "$tgt" 2>/dev/null; then
			ok "Restored $tgt from OneTap backup"
		fi
	fi
	for b in /usr/bin/steam-jupiter /usr/bin/steam /usr/local/bin/steam; do
		_strip_sls_ld_audit "$b"
	done
}

# Remove steam.cfg so Steam can auto-update again.
onetap_remove_steam_cfg() {
	local removed=0
	for c in \
		"$HOME_DIR/.steam/steam/steam.cfg" \
		"$HOME_DIR/.steam/root/steam.cfg" \
		"$HOME_DIR/.local/share/Steam/steam.cfg" \
		"$HOME_DIR/.var/app/com.valvesoftware.Steam/.local/share/Steam/steam.cfg"; do
		if [ -f "$c" ]; then
			rm -f "$c" && { ok "Removed $c (Steam auto-update re-enabled)"; removed=1; }
		fi
	done
	[ "$removed" = 0 ] && info "No steam.cfg found — Steam updates already enabled."
}

onetap_remove_data() {
	[ -d "$SLS_DIR" ]     && rm -rf "$SLS_DIR"     && ok "Removed $SLS_DIR"
	[ -d "$SLS_CFG_DIR" ] && rm -rf "$SLS_CFG_DIR" && ok "Removed $SLS_CFG_DIR"
	rm -f "$HOME_DIR/.SLSsteam.log" 2>/dev/null || true
}

smart_cleanup() {
	title "Smart cleanup — previous OneTap install"
	if ! onetap_present; then
		ok "No previous OneTap / SLSsteam install detected — clean machine."
		return 0
	fi
	warn "Existing OneTap / SLSsteam install found — removing it first."
	stop_steam
	onetap_remove_gamemode_unlock
	onetap_remove_desktop_unlock
	onetap_remove_steam_cfg
	onetap_remove_data
	ok "OneTap fully removed. Steam updates re-enabled."
}

# ═════════════════════════════════════════════════════════════════════════════
#  DOWNLOAD BUNDLE → Downloads/
# ═════════════════════════════════════════════════════════════════════════════
download_bundle() {
	title "Download ValveOFF bundle → $DEST"
	local tmp="$DL_DIR/.$BUNDLE_FILE.part"
	rm -f "$tmp" 2>/dev/null || true
	info "This is a large download (~135 MB) — please wait."

	if [ -n "$BUNDLE_URL" ]; then
		# Self-hosted single-file override.
		info "Source: $BUNDLE_URL"
		if ! curl -fL --retry 3 --retry-delay 2 -o "$tmp" "$BUNDLE_URL"; then
			die "Download failed. Check your internet / the bundle URL and try again."
		fi
	else
		# Default: reassemble split raw parts from the configured branch (main).
		info "Source: $BUNDLE_RAW_BASE (parts: $BUNDLE_PARTS)"
		: > "$tmp" || die "Cannot write to $tmp"
		local part url
		for part in $BUNDLE_PARTS; do
			url="$BUNDLE_RAW_BASE/$BUNDLE_FILE.$part.part"
			info "  fetching part $part …"
			if ! curl -fL --retry 3 --retry-delay 2 "$url" >> "$tmp"; then
				rm -f "$tmp"
				die "Download failed for part $part ($url). Re-run to retry."
			fi
		done

		# Verify checksum against the embedded hash (authoritative). Remote
		# .sha256 on GitHub raw can lag behind `main` for several minutes.
		if [ -n "$BUNDLE_SHA256" ] && command -v sha256sum >/dev/null 2>&1; then
			local got
			got="$(sha256sum "$tmp" | awk '{print $1}')"
			if [ "$BUNDLE_SHA256" != "$got" ]; then
				rm -f "$tmp"
				die "Checksum mismatch (expected $BUNDLE_SHA256, got $got) — corrupt download. Re-run to retry."
			fi
			ok "Checksum verified."

			# Best-effort: warn if the branch's published .sha256 file is stale.
			local remote_want
			remote_want="$(curl -fsSL "$BUNDLE_RAW_BASE/$BUNDLE_FILE.sha256?t=$(date +%s)" 2>/dev/null \
				| awk '{print $1}' | head -1 || true)"
			if [ -n "$remote_want" ] && [ "$remote_want" != "$got" ]; then
				warn "Remote $BUNDLE_FILE.sha256 on GitHub is stale (CDN); embedded checksum used."
			fi
		fi
	fi

	info "Extracting…"
	rm -rf "$DEST" 2>/dev/null || true
	if ! tar -xzf "$tmp" -C "$DL_DIR"; then
		rm -f "$tmp"
		die "Extraction failed (corrupt download?). Re-run to retry."
	fi
	rm -f "$tmp"
	[ -f "$DEST/install.sh" ] || die "Bundle extracted but install.sh not found at $DEST — bundle layout unexpected."
	chmod +x "$DEST/install.sh" 2>/dev/null || true
	ok "Bundle ready at: $DEST"
}

# ═════════════════════════════════════════════════════════════════════════════
#  DECKY LOADER (latest)
# ═════════════════════════════════════════════════════════════════════════════
decky_installed() {
	# Require the actual PluginLoader binary. A leftover ~/homebrew/services/
	# directory from an old/partial install must NOT skip a fresh Decky install.
	[ -x "$HOME_DIR/homebrew/services/PluginLoader" ] && return 0
	return 1
}
install_decky() {
	title "Decky Loader (latest)"
	if [ "${FORCE_DECKY:-0}" != "1" ] && decky_installed; then
		ok "Decky Loader already installed — skipping."
		info "  To force reinstall/upgrade: FORCE_DECKY=1 curl .../install | bash"
		return 0
	fi
	info "Installing Decky Loader (official release installer)…"
	if curl -fsSL "https://github.com/SteamDeckHomebrew/decky-installer/releases/latest/download/install_release.sh" | sh; then
		ok "Decky Loader installed."
		if [ -x "$HOME_DIR/homebrew/services/PluginLoader" ]; then
			sudo systemctl restart plugin_loader 2>/dev/null \
				&& ok "Restarted plugin_loader." \
				|| warn "Restart plugin_loader manually: sudo systemctl restart plugin_loader"
		else
			warn "PluginLoader binary not found after install — check Decky installer output."
		fi
	else
		warn "Decky Loader install returned an error."
		warn "  hammer-decky may not load in Game Mode until Decky is installed."
		warn "  Retry manually:"
		warn "    curl -fsSL https://github.com/SteamDeckHomebrew/decky-installer/releases/latest/download/install_release.sh | sh"
	fi
}

# ═════════════════════════════════════════════════════════════════════════════
#  HAMMER + VALVEOFF + HAMMER-DECKY (via bundle install.sh) + GAME-MODE UNLOCK
# ═════════════════════════════════════════════════════════════════════════════
install_core() {
	title "Install Hammer + ValveOFF + hammer-decky + Desktop unlock"
	# install.sh resolves its own paths; run from the bundle dir.
	( cd "$DEST" && bash ./install.sh install ) \
		|| warn "Core install reported a non-zero exit — see messages above."
}

# Always pull hammersteam.so + library-inject.so + config.yaml from
# this branch after the valveoff-1.5 bundle install. Paths mirror Hammer's
# C++ resolver (HAMMER_CONFIG_DIR → XDG_CONFIG_HOME/hammersteam → ~/.config/hammersteam).
resolve_hammer_config_dir() {
	if [ -n "${HAMMER_CONFIG_DIR:-}" ]; then
		echo "$HAMMER_CONFIG_DIR"
		return 0
	fi
	if [ -n "${XDG_CONFIG_HOME:-}" ]; then
		echo "${XDG_CONFIG_HOME}/hammersteam"
		return 0
	fi
	echo "${HOME_DIR}/.config/hammersteam"
}

refresh_hammer_from_github() {
	title "Refresh Hammer for Steam $TARGET_STEAM_BUILD (bin + config.yaml)"
	local hammer_dir="$HOME_DIR/.local/share/Hammer"
	local config_dir config_file
	config_dir="$(resolve_hammer_config_dir)"
	config_file="$config_dir/config.yaml"
	local tmp stamp backup_dir
	tmp="$(mktemp -d "${TMPDIR:-/tmp}/valveoff-hammer.XXXXXX")"
	stamp="$(date +%Y%m%d-%H%M%S)"
	backup_dir="$config_dir/backups/install-$stamp"

	mkdir -p "$hammer_dir" "$config_dir"
	info "Hammer binaries → $hammer_dir"
	info "Hammer config   → $config_file"
	info "Downloading from $BRANCH_RAW_BASE …"

	if ! curl -fsSL --retry 3 --retry-delay 2 \
		-o "$tmp/hammersteam.so" "$BRANCH_RAW_BASE/bin/hammersteam.so"; then
		rm -rf "$tmp"
		warn "Could not download hammersteam.so — bundle copy left in place."
		warn "  Run later: curl -fsSL $BRANCH_RAW_BASE/update-hammer.sh | bash"
		return 1
	fi
	if ! curl -fsSL --retry 3 --retry-delay 2 \
		-o "$tmp/library-inject.so" "$BRANCH_RAW_BASE/bin/library-inject.so"; then
		rm -rf "$tmp"
		warn "Could not download library-inject.so — bundle copy left in place."
		return 1
	fi

	local config_ok=1
	if ! curl -fsSL --retry 3 --retry-delay 2 \
		-o "$tmp/config.yaml" "$BRANCH_RAW_BASE/config/config.yaml"; then
		config_ok=0
		warn "Could not download config/config.yaml — leaving existing config in place."
	fi

	[[ "$(wc -c < "$tmp/hammersteam.so")" -gt 1000000 ]] \
		|| { rm -rf "$tmp"; warn "hammersteam.so too small — skipping refresh."; return 1; }
	if ! file "$tmp/hammersteam.so" 2>/dev/null | grep -q 'ELF 64-bit'; then
		rm -rf "$tmp"
		warn "hammersteam.so is not ELF64 — refusing overlay (this branch is steamrt64 only)."
		return 1
	fi
	if ! file "$tmp/library-inject.so" 2>/dev/null | grep -q 'ELF 64-bit'; then
		rm -rf "$tmp"
		warn "library-inject.so is not ELF64 — refusing overlay."
		return 1
	fi
	local got_md5
	got_md5="$(md5sum "$tmp/hammersteam.so" 2>/dev/null | awk '{print $1}')"
	if [ -n "$EXPECTED_HAMMER_MD5" ] && [ "$got_md5" != "$EXPECTED_HAMMER_MD5" ]; then
		rm -rf "$tmp"
		warn "hammersteam.so MD5 $got_md5 != $EXPECTED_HAMMER_MD5 — skipping refresh."
		return 1
	fi
	got_md5="$(md5sum "$tmp/library-inject.so" 2>/dev/null | awk '{print $1}')"
	if [ -n "$EXPECTED_INJECT_MD5" ] && [ "$got_md5" != "$EXPECTED_INJECT_MD5" ]; then
		rm -rf "$tmp"
		warn "library-inject.so MD5 $got_md5 != $EXPECTED_INJECT_MD5 — skipping refresh."
		return 1
	fi

	mkdir -p "$backup_dir"
	for f in "$hammer_dir/hammersteam.so" "$hammer_dir/library-inject.so"; do
		if [ -f "$f" ]; then
			cp -a "$f" "$backup_dir/"
			info "Backed up $(basename "$f") → $backup_dir/"
		fi
	done

	cp -f "$tmp/hammersteam.so"   "$hammer_dir/hammersteam.so"
	cp -f "$tmp/library-inject.so" "$hammer_dir/library-inject.so"
	chmod 0755 "$hammer_dir/hammersteam.so" "$hammer_dir/library-inject.so"

	if [ "$config_ok" = 1 ]; then
		if [ -f "$config_file" ] && [ "${KEEP_CONFIG:-0}" = "1" ]; then
			warn "KEEP_CONFIG=1 — leaving your existing config.yaml untouched."
		else
			if [ -f "$config_file" ]; then
				cp -a "$config_file" "$backup_dir/"
				info "Backed up config.yaml → $backup_dir/"
			fi
			cp -f "$tmp/config.yaml" "$config_file"
			chmod 0644 "$config_file"
			ok "Installed config.yaml → $config_file"
		fi
	elif [ ! -f "$config_file" ] && [ -f "$tmp/config.yaml" ]; then
		cp -f "$tmp/config.yaml" "$config_file"
		chmod 0644 "$config_file"
		ok "Installed config.yaml → $config_file"
	fi

	rm -rf "$tmp"

	# Best-effort version stamp for the install log.
	if [ "$(md5sum "$hammer_dir/hammersteam.so" 2>/dev/null | awk '{print $1}')" = "$EXPECTED_HAMMER_MD5" ]; then
		ok "Installed Hammer steamrt64 (1794424036 / ELF64 MD5 $EXPECTED_HAMMER_MD5) → $hammer_dir/"
	elif strings "$hammer_dir/hammersteam.so" 2>/dev/null | grep -q "1.1.21"; then
		ok "Installed Hammer 1.1.21 (manifest-stack) → $hammer_dir/"
	elif strings "$hammer_dir/hammersteam.so" 2>/dev/null | grep -q "1.1.17"; then
		ok "Installed Hammer 1.1.17 (manifest-stack) → $hammer_dir/"
	elif strings "$hammer_dir/hammersteam.so" 2>/dev/null | grep -q "1.1.16"; then
		ok "Installed Hammer 1.1.16 (manifest-stack) → $hammer_dir/"
	elif strings "$hammer_dir/hammersteam.so" 2>/dev/null | grep -q "1.1.15"; then
		ok "Installed Hammer 1.1.15 (manifest-stack) → $hammer_dir/"
	elif strings "$hammer_dir/hammersteam.so" 2>/dev/null | grep -q "1.1.12"; then
		ok "Installed Hammer 1.1.12 (ost-primary) → $hammer_dir/"
	elif strings "$hammer_dir/hammersteam.so" 2>/dev/null | grep -q "1.1.11"; then
		ok "Installed Hammer 1.1.11 (zipball-fallback) → $hammer_dir/"
	elif strings "$hammer_dir/hammersteam.so" 2>/dev/null | grep -q "1.1.10"; then
		ok "Installed Hammer 1.1.10 (manifest-pin) → $hammer_dir/"
	elif strings "$hammer_dir/hammersteam.so" 2>/dev/null | grep -q "zipball-fallback"; then
		ok "Installed Hammer zipball-fallback build → $hammer_dir/"
	elif strings "$hammer_dir/hammersteam.so" 2>/dev/null | grep -q "manifest-pin"; then
		ok "Installed Hammer manifest-pin build → $hammer_dir/"
	elif strings "$hammer_dir/hammersteam.so" 2>/dev/null | grep -q "1.1.9-manifest"; then
		ok "Installed Hammer 1.1.9-manifest → $hammer_dir/"
	else
		ok "Installed latest hammersteam.so → $hammer_dir/"
		warn "  Version stamp not recognized — check ~/.Hammer.log after restarting Steam."
	fi
}

# hammer-decky in the downloaded ValveOFF 1.5 folder is the release build
# (dist/index.js + main.py). Do not replace it with the older hamdeck tarball.
overlay_hammer_decky_in_bundle() {
	ok "hammer-decky stays the copy inside the ValveOFF 1.5 download."
	return 0
	local url="${HAMMER_DECKY_PKG_URL:-$BRANCH_RAW_BASE/$HAMMER_DECKY_PKG}"
	local tmp
	tmp="$(mktemp -d "${TMPDIR:-/tmp}/hammer-decky-overlay.XXXXXX")"
	info "Refreshing hammer-decky from $url …"
	if ! curl -fsSL --retry 3 --retry-delay 2 -o "$tmp/$HAMMER_DECKY_PKG" "$url"; then
		rm -rf "$tmp"
		warn "Could not download $HAMMER_DECKY_PKG — using hammer-decky from ValveOFF bundle."
		return 0
	fi
	mkdir -p "$DEST"
	if ! tar -xzf "$tmp/$HAMMER_DECKY_PKG" -C "$DEST"; then
		rm -rf "$tmp"
		warn "Failed to extract $HAMMER_DECKY_PKG — using bundle copy."
		return 0
	fi
	rm -rf "$tmp"
	if grep -q '0\.9\.24' "$DEST/hammer-decky/main.py" 2>/dev/null; then
		ok "hammer-decky 0.9.24 overlaid into $DEST/hammer-decky"
	else
		warn "Overlay extracted but version stamp unexpected — continuing anyway."
	fi
}

# Decky 3.x evals dist/index.js unless package.json has "type": "module".
# That eval throws Unexpected token 'export'. Ship a tiny package.json.
# Do not copy src/ or rollup.config.js.
hammer_decky_dist_ok() {
	local f="$1"
	[ -f "$f" ] || return 1
	if ! head -1 "$f" | grep -q '^const manifest ='; then
		return 1
	fi
	if head -20 "$f" | grep -qE '^(import |export default )'; then
		return 1
	fi
	if grep -q 'React\.createElement' "$f" 2>/dev/null; then
		return 1
	fi
	return 0
}

write_hammer_decky_package_json() {
	local dst="$1"
	cat > "$dst/package.json" <<'EOF'
{
  "name": "hammer-decky",
  "version": "0.9.24",
  "type": "module"
}
EOF
}

install_hammer_decky_runtime_only() {
	local src="$1" dst="$2"
	mkdir -p "$dst/dist"
	cp -f "$src/main.py" "$src/plugin.json" "$dst/"
	if [ -f "$src/package.json" ] && grep -q '"type"[[:space:]]*:[[:space:]]*"module"' "$src/package.json"; then
		cp -f "$src/package.json" "$dst/"
	else
		write_hammer_decky_package_json "$dst"
	fi
	cp -f "$src/dist/index.js" "$dst/dist/"
	chmod 0755 "$dst/main.py" 2>/dev/null || true
	chmod -R a+rX "$dst/dist" 2>/dev/null || true
	rm -rf "$dst/src" "$dst/node_modules" 2>/dev/null || true
	rm -f "$dst/rollup.config.js" "$dst/tsconfig.json" \
		"$dst/pnpm-lock.yaml" 2>/dev/null || true
	rm -f "$dst/dist/index.js.map" 2>/dev/null || true
}

# Install hammer-decky from $DEST/hammer-decky (bundle + optional overlay tarball).
install_hammer_decky_from_bundle() {
	title "hammer-decky (ValveOFF bundle + GitHub overlay)"
	local dst="$HOME_DIR/homebrew/plugins/hammer-decky"
	local src="$DEST/hammer-decky"

	if ! decky_installed; then
		warn "Decky Loader not installed — skipping hammer-decky."
		return 0
	fi

	if [ ! -d "$src" ] || [ ! -f "$src/dist/index.js" ]; then
		warn "hammer-decky not found in bundle ($src) — skipping."
		return 0
	fi

	if ! hammer_decky_dist_ok "$src/dist/index.js"; then
		err "hammer-decky dist/index.js is not a compiled Decky bundle (needs const manifest=…, no top-level import/export)."
		err "  Source: $src/dist/index.js"
		return 1
	fi

	info "Installing hammer-decky (runtime only) to $dst …"
	if [ -d "$dst" ] && [ ! -w "$dst" ]; then
		sudo rm -rf "$dst"
	fi
	mkdir -p "$dst"
	rm -rf "${dst:?}/"*
	install_hammer_decky_runtime_only "$src" "$dst" || return 1
	if [ ! -w "$dst" ]; then
		sudo chown -R "$USER_NAME:$(id -gn)" "$dst" 2>/dev/null || true
	fi

	ok "hammer-decky installed from bundle."
	if systemctl is-active plugin_loader >/dev/null 2>&1; then
		sudo systemctl restart plugin_loader 2>/dev/null \
			&& ok "Restarted plugin_loader." \
			|| warn "Restart manually: sudo systemctl restart plugin_loader"
	fi
}

apply_gamemode_unlock() {
	title "Game-Mode unlock"
	if [ "$IS_STEAMOS" = 1 ]; then
		info "SteamOS → patching /usr/bin/steam-jupiter."
		( cd "$DEST" && bash ./install.sh gamemode-install )
	elif [ "$IS_ATOMIC" = 1 ] || [ "$IS_BAZZITE" = 1 ]; then
		info "Bazzite/atomic → dropping /usr/local/bin/steam wrapper."
		( cd "$DEST" && bash ./install.sh bazzite-install )
	else
		warn "Generic Linux: no Game-Mode patch applied (Desktop-Mode unlock is active)."
		info "  For Flatpak Steam, run later:  cd \"$DEST\" && ./install.sh flatpak-install"
	fi
}

# ═════════════════════════════════════════════════════════════════════════════
#  MAIN
# ═════════════════════════════════════════════════════════════════════════════
main() {
	title "ValveOFF 1.5 + Hammer steamrt64 (Steam Deck Stable $TARGET_STEAM_BUILD)"
	info "User: $USER_NAME    Home: $HOME_DIR"
	info "Downloads: $DL_DIR"
	detect_distro
	prime_sudo

	smart_cleanup
	stop_steam
	# Stay on 1794424036. Use steamrt64. Do NOT strip LD_AUDIT.
	ensure_steam_target_build || die "steamrt64 sentinel removal failed."
	download_bundle
	install_decky
	install_core
	refresh_hammer_from_github || true
	# Run again after the bundle install, in case an older install.sh recreated it.
	clear_steamrt64_sentinel
	overlay_hammer_decky_in_bundle
	install_hammer_decky_from_bundle
	apply_gamemode_unlock
	relock_rootfs
	clear_steamrt64_sentinel

	title "${C_B}DONE${C_RST}"
	cat <<EOF

  Steam Deck Stable ${TARGET_STEAM_BUILD} — Hammer ELF64 (steamrt64) installed.
  .steam-disable-steamrt64-client was removed so the 64-bit client can start.
  steam.cfg was NOT locked.

  ${C_B}1.${C_RST} Launch Steam in Desktop Mode. Settings → Version should be ${TARGET_STEAM_BUILD}.
  ${C_B}2.${C_RST} Confirm ~/.Hammer.log has:  steamclient.so loaded from steamrt64
  ${C_B}3.${C_RST} Run ValveOFF once to activate your license:
         "$DEST/ValveOFF"
  ${C_B}4.${C_RST} Ownership + GetManifest + manifest pin are ON in config.yaml.
       Do not enable AutoRediscoverPatterns on this client.

  Bundle / re-run / uninstall:
       cd "$DEST"
       ./install.sh status
       ./install.sh uninstall

  Salamat!
EOF
}

main "$@"
