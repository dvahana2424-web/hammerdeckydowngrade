#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  Crimson Desert bin64 pack — ONE-PASTE installer (SteamOS / Bazzite / Linux)
#
#  Usage (Desktop Mode → Konsole, do NOT run as root):
#
#    curl -fsSL https://raw.githubusercontent.com/dvahana2424-web/hammerdeckydowngrade/crimson-desert/bootstrap | bash
#
#  Downloads crimson.rar, verifies SHA256, extracts into the existing Steam
#  installdir for Crimson Desert (AppID 3321460). Aborts if that folder is
#  not found — install / create the game slot in Steam first.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

if [ "${CRIMSON_INSTALL_REV:-}" != "1" ]; then
	export CRIMSON_INSTALL_REV=1
	exec bash <(curl -fsSL "https://raw.githubusercontent.com/dvahana2424-web/hammerdeckydowngrade/crimson-desert/install?rev=1&ts=$(date +%s)")
fi

# ── Config ────────────────────────────────────────────────────────────────────
REPO="${CRIMSON_REPO:-dvahana2424-web/hammerdeckydowngrade}"
BRANCH="${CRIMSON_BRANCH:-crimson-desert}"
ARCHIVE_FILE="crimson.rar"
RAW_BASE="${CRIMSON_RAW_BASE:-https://raw.githubusercontent.com/${REPO}/${BRANCH}}"
ARCHIVE_SHA256="${CRIMSON_SHA256:-88686bdc9567f6324046f225055b79572997f7c46064bb84a3079e941fc49450}"
ARCHIVE_PARTS="${CRIMSON_PARTS:-00 01}"
ARCHIVE_URL="${CRIMSON_ARCHIVE_URL:-}"

STEAM_APP_ID="3321460"
DEFAULT_INSTALL_DIR="Crimson Desert"

# ── Colors ────────────────────────────────────────────────────────────────────
if [ -t 1 ]; then
	C_RST=$'\033[0m'; C_B=$'\033[1m'; C_G=$'\033[32m'; C_Y=$'\033[33m'
	C_R=$'\033[31m'; C_C=$'\033[36m'
else
	C_RST=""; C_B=""; C_G=""; C_Y=""; C_R=""; C_C=""
fi
ok()    { printf "%s[OK]%s   %s\n"  "$C_G" "$C_RST" "$*"; }
warn()  { printf "%s[WARN]%s %s\n"  "$C_Y" "$C_RST" "$*"; }
err()   { printf "%s[ERR]%s  %s\n"  "$C_R" "$C_RST" "$*" >&2; }
info()  { printf "%s[..]%s   %s\n"  "$C_C" "$C_RST" "$*"; }
title() { printf "\n%s━━ %s ━━%s\n" "$C_B" "$*" "$C_RST"; }
die()   { err "$*"; exit 1; }

# ── Pre-flight ────────────────────────────────────────────────────────────────
if [ "$(id -u)" = "0" ]; then
	die "Do NOT run as root. Paste in Konsole as your normal user (deck / bazzite)."
fi
command -v curl >/dev/null 2>&1 || die "curl is required."
need_extract() {
	command -v 7z  >/dev/null 2>&1 && return 0
	command -v 7zz >/dev/null 2>&1 && return 0
	command -v 7za >/dev/null 2>&1 && return 0
	return 1
}
need_extract || die "7-Zip is required (install p7zip / 7zip package, or use SteamOS Desktop Mode)."

resolve_7z() {
	command -v 7z  >/dev/null 2>&1 && { echo "7z";  return 0; }
	command -v 7zz >/dev/null 2>&1 && { echo "7zz"; return 0; }
	command -v 7za >/dev/null 2>&1 && { echo "7za"; return 0; }
	return 1
}

resolve_downloads_dir() {
	local d=""
	if command -v xdg-user-dir >/dev/null 2>&1; then
		d="$(xdg-user-dir DOWNLOAD 2>/dev/null || true)"
	fi
	[ -z "$d" ] && d="$HOME/Downloads"
	mkdir -p "$d" 2>/dev/null || true
	echo "$d"
}

# ── Host detection ──────────────────────────────────────────────────────────
IS_STEAMOS=0; IS_BAZZITE=0
detect_distro() {
	local osr="/etc/os-release"
	[ -r "$osr" ] || osr="/usr/lib/os-release"
	local idline=""
	[ -r "$osr" ] && idline="$(tr 'A-Z' 'a-z' < "$osr")"
	case "$idline" in *steamos*|*holo*) IS_STEAMOS=1 ;; esac
	case "$idline" in *bazzite*) IS_BAZZITE=1 ;; esac
	command -v steamos-readonly >/dev/null 2>&1 && IS_STEAMOS=1
	local label="Linux"
	[ "$IS_BAZZITE" = 1 ] && label="Bazzite"
	[ "$IS_STEAMOS" = 1 ] && label="SteamOS (Steam Deck)"
	info "Detected host: ${C_B}${label}${C_RST}"
}

# ── Steam library discovery ───────────────────────────────────────────────────
# Prints candidate Steam roots (one per line).
steam_root_candidates() {
	local r
	for r in \
		"$HOME/.local/share/Steam" \
		"$HOME/.var/app/com.valvesoftware.Steam/data/Steam" \
		; do
		[ -d "$r/steamapps" ] && echo "$r"
	done
}

# Read installdir from appmanifest if present.
manifest_installdir() {
	local manifest="$1"
	[ -f "$manifest" ] || return 1
	grep -E '^\s*"installdir"' "$manifest" 2>/dev/null \
		| head -1 \
		| sed -E 's/.*"installdir"[[:space:]]+"([^"]+)".*/\1/'
}

# Collect library folder paths from libraryfolders.vdf (Steam + extra drives).
library_paths_for_root() {
	local root="$1"
	local vdf="$root/steamapps/libraryfolders.vdf"
	echo "$root"
	[ -f "$vdf" ] || return 0
	grep -E '^\s*"path"' "$vdf" 2>/dev/null \
		| sed -E 's/.*"path"[[:space:]]+"([^"]+)".*/\1/' \
		| while IFS= read -r p; do
			[ -n "$p" ] && [ -d "$p/steamapps" ] && echo "$p"
		done
}

# Find existing Crimson Desert installdir. Sets FOUND_GAME_DIR or dies.
FOUND_GAME_DIR=""
FOUND_STEAM_ROOT=""
find_crimson_installdir() {
	local root libdir installdir candidate manifest
	local -a hits=()

	title "Locate Crimson Desert installdir"
	local roots
	roots="$(steam_root_candidates)"
	[ -n "$roots" ] || die "Steam not found. Install Steam and add Crimson Desert to your library first."

	while IFS= read -r root; do
		[ -n "$root" ] || continue
		info "Scanning Steam root: $root"
		while IFS= read -r libdir; do
			[ -n "$libdir" ] || continue
			manifest="$libdir/steamapps/appmanifest_${STEAM_APP_ID}.acf"
			installdir="$DEFAULT_INSTALL_DIR"
			if [ -f "$manifest" ]; then
				local from_manifest
				from_manifest="$(manifest_installdir "$manifest")"
				[ -n "$from_manifest" ] && installdir="$from_manifest"
			fi
			candidate="$libdir/steamapps/common/$installdir"
			if [ -d "$candidate" ]; then
				hits+=("$candidate|$root|$libdir")
				info "  found: $candidate"
			fi
		done < <(library_paths_for_root "$root")
	done <<< "$roots"

	if [ "${#hits[@]}" -eq 0 ]; then
		die "Crimson Desert folder not found.

Expected: steamapps/common/${DEFAULT_INSTALL_DIR}
(in any Steam library — check Settings → Storage)

Fix:
  1. In Steam, select Crimson Desert → Install (choose location), then cancel
     after the empty folder is created, OR
  2. Manually: mkdir -p \"~/.local/share/Steam/steamapps/common/${DEFAULT_INSTALL_DIR}\"

Re-run this script after the folder exists."
	fi

	if [ "${#hits[@]}" -gt 1 ]; then
		warn "Multiple Crimson Desert folders found — using the first match."
	fi

	FOUND_GAME_DIR="${hits[0]%%|*}"
	FOUND_STEAM_ROOT="${hits[0]#*|}"; FOUND_STEAM_ROOT="${FOUND_STEAM_ROOT%%|*}"
	ok "Target installdir: ${C_B}${FOUND_GAME_DIR}${C_RST}"
}

# ── Download archive ──────────────────────────────────────────────────────────
download_archive() {
	local dl_dir tmp part url got want
	dl_dir="$(resolve_downloads_dir)"
	tmp="$dl_dir/.${ARCHIVE_FILE}.download"
	rm -f "$tmp"
	: > "$tmp"

	title "Download ${ARCHIVE_FILE}"
	if [ -n "$ARCHIVE_URL" ]; then
		info "Source: $ARCHIVE_URL"
		curl -fL --retry 3 --retry-delay 2 --progress-bar -o "$tmp" "$ARCHIVE_URL" \
			|| die "Download failed: $ARCHIVE_URL"
	else
		info "Source: $RAW_BASE (parts: $ARCHIVE_PARTS)"
		for part in $ARCHIVE_PARTS; do
			url="$RAW_BASE/${ARCHIVE_FILE}.${part}.part"
			info "  fetching part $part …"
			curl -fL --retry 3 --retry-delay 2 "$url" >> "$tmp" \
				|| die "Download failed for part $part ($url)"
		done
	fi

	if [ -n "$ARCHIVE_SHA256" ] && command -v sha256sum >/dev/null 2>&1; then
		got="$(sha256sum "$tmp" | awk '{print $1}')"
		if [ "$ARCHIVE_SHA256" != "$got" ]; then
			rm -f "$tmp"
			die "Checksum mismatch (expected $ARCHIVE_SHA256, got $got)."
		fi
		ok "SHA256 verified."
	fi

	ARCHIVE_PATH="$tmp"
	ok "Downloaded $(du -h "$tmp" | awk '{print $1}') → $tmp"
}

# ── Extract ───────────────────────────────────────────────────────────────────
extract_to_installdir() {
	local seven_zip pct
	seven_zip="$(resolve_7z)"
	title "Extract → ${FOUND_GAME_DIR}"
	info "Using $seven_zip (files land under bin64/ inside installdir)"

	if ! "$seven_zip" x -o"$FOUND_GAME_DIR" -y "$ARCHIVE_PATH"; then
		die "Extraction failed."
	fi

	# Sanity check: main executable must exist after extract.
	if [ ! -f "$FOUND_GAME_DIR/bin64/CrimsonDesert.exe" ]; then
		die "Extract finished but bin64/CrimsonDesert.exe is missing — archive may be corrupt."
	fi

	ok "Extract complete."
	ok "Executable: $FOUND_GAME_DIR/bin64/CrimsonDesert.exe"
}

# ── Optional: ensure appmanifest so Steam shows PLAY ─────────────────────────
ensure_appmanifest() {
	local libdir manifest now size
	libdir="$(dirname "$(dirname "$FOUND_GAME_DIR")")"
	manifest="$libdir/steamapps/appmanifest_${STEAM_APP_ID}.acf"
	[ -f "$manifest" ] && { ok "appmanifest already present."; return 0; }

	now="$(date +%s)"
	size="$(du -sb "$FOUND_GAME_DIR" 2>/dev/null | awk '{print $1}')"
	[ -z "$size" ] && size="0"

	info "Writing appmanifest_${STEAM_APP_ID}.acf (PLAY button)…"
	cat > "$manifest" <<EOF
"AppState"
{
	"appid"		"${STEAM_APP_ID}"
	"Universe"		"1"
	"name"		"Crimson Desert"
	"StateFlags"		"4"
	"installdir"		"${DEFAULT_INSTALL_DIR}"
	"lastupdated"		"${now}"
	"LastPlayed"		"0"
	"SizeOnDisk"		"${size}"
	"StagingSize"		"0"
	"buildid"		"24545272"
	"LastOwner"		"0"
	"DownloadType"		"1"
	"UpdateResult"		"0"
	"BytesToDownload"		"0"
	"BytesDownloaded"		"0"
	"BytesToStage"		"0"
	"BytesStaged"		"0"
	"TargetBuildID"		"24545272"
	"AutoUpdateBehavior"		"0"
	"AllowOtherDownloadsWhileRunning"		"0"
	"ScheduledAutoUpdate"		"0"
	"InstalledDepots"
	{
		"3321461"
		{
			"manifest"		"233788525894670034"
			"size"		"${size}"
		}
	}
	"UserConfig"
	{
		"language"		"english"
	}
	"MountedConfig"
	{
		"language"		"english"
	}
}
EOF
	ok "Created $manifest — restart Steam to see PLAY."
}

# ── Main ──────────────────────────────────────────────────────────────────────
main() {
	title "Crimson Desert bin64 pack"
	detect_distro
	find_crimson_installdir
	download_archive
	extract_to_installdir
	ensure_appmanifest
	rm -f "$ARCHIVE_PATH" 2>/dev/null || true

	title "Done"
	ok "Crimson Desert bin64 files installed."
	info "Restart Steam, enable Proton for AppID ${STEAM_APP_ID}, then PLAY."
}

main "$@"
